---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  /** Path to a share image, relative to the site root. */
  image?: string;
  /** "website" for pages, "article" for blog posts. */
  type?: string;
  publishedTime?: Date;
}
const {
  title = "Inderjit Singh Chahal — Machine Learning Engineer",
  description = "Machine Learning Engineer building production deep-learning systems. Claude Certified Architect (Professional) and Google Cloud Professional Machine Learning Engineer.",
  image = "/images/og.png",
  type = "website",
  publishedTime,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <!-- mark JS available before paint so reveal-animations only hide content when JS can restore it -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Inderjit Singh Chahal" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@Inderjitsingh08" />

    <meta name="theme-color" content="#0c0d10" />
    <link rel="icon" type="image/jpeg" href="/images/me.jpg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Inderjit Singh Chahal — Writing" href="/rss.xml" />

    <!-- fonts: Fraunces (display serif), Hanken Grotesk (body), JetBrains Mono (data) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..600&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />

    <script>
      // staggered reveal on scroll/load
      const els = document.querySelectorAll("[data-reveal]");
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );
      els.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
