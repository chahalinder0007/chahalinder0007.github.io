                <p class="cert-issuer mono">{c.issuer}</p>
                <h3 class="cert-name display">{c.name}</h3>
                <p class="cert-blurb">{c.blurb}</p>

                <dl class="cert-spec mono">
                  <div><dt>Issued</dt><dd>{c.issued}</dd></div>
                  <div><dt>Valid to</dt><dd>{c.validTo}</dd></div>
                  <div><dt>Level</dt><dd>{c.level}</dd></div>
                </dl>

                <ul class="cert-skills mono">
                  {c.skills.map((sk) => <li>{sk}</li>)}
                  <li class="more">+{c.more}</li>
                </ul>

                <span class="cert-verify mono"><span>Verify on Credly &#8599;</span></span>
