                <img
                  class="seal-badge"
                  src={c.img}
                  alt={`${c.name} badge`}
                  width="300"
                  height="300"
                  loading="lazy"
                />
              </span>

              <div class="cert-body">
                <span class="verified mono">
                  <span class="verified-dot" aria-hidden="true"></span>Verified
