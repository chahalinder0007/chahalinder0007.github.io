  <Footer />

  <script>
    // ensure the hero particle video plays (some browsers ignore the autoplay
    // attribute alone even when muted); retry on tab focus.
    const v = document.querySelector(".hero-bg video");
    if (v) {
      const play = () => v.play().catch(() => {});
      play();
      v.addEventListener("canplay", play, { once: true });
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden) play();
      });
    }

    // One-time nudge down to the credentials section for a visitor who has
    // landed and not moved. It is deliberately timid: any wheel, touch, key or
    // pointer input cancels it (before or mid-flight), it never fires twice in
    // a session, and it stays out of the way of anyone who arrived with a
    // destination in mind or asked for reduced motion.
    (() => {
      const KEY = "creds-nudge";
      const target = document.getElementById("credentials");
      const root = document.documentElement;
      if (!target) return;
      if (location.hash) return;                       // they aimed at a section
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      try { if (sessionStorage.getItem(KEY)) return; } catch {}

      const moved = () => window.scrollY > 4;
      if (moved()) return;

      let cancelled = false;
      const EVENTS = ["wheel", "touchstart", "keydown", "pointerdown"];
      const stop = () => { cancelled = true; disarm(); teardown(); };
      const teardown = () => EVENTS.forEach((e) => window.removeEventListener(e, stop));
      EVENTS.forEach((e) => window.addEventListener(e, stop, { passive: true }));

      // count ten seconds of the page actually being looked at: a tab opened in
      // the background should still get its nudge when it is brought forward
      let timer = null;
      const arm = () => { if (timer === null && !document.hidden && !cancelled) timer = setTimeout(fire, 10000); };
      const disarm = () => { if (timer !== null) { clearTimeout(timer); timer = null; } };
      document.addEventListener("visibilitychange", () => (document.hidden ? disarm() : arm()));

      function fire() {
        timer = null;
        if (cancelled || moved()) return teardown();

        const NAV = 76;
        const start = window.scrollY;
        const end = target.getBoundingClientRect().top + start - NAV;
        // already on screen? then there is nothing to point at
        if (end - start < innerHeight * 0.45) return teardown();

        try { sessionStorage.setItem(KEY, "1"); } catch {}

        // drive it per-frame so a cancel lands immediately; native smooth
        // scrolling would keep going after we stopped listening
        const prev = root.style.scrollBehavior;
        root.style.scrollBehavior = "auto";
        const dist = end - start;
        const DUR = 1500;
        const t0 = performance.now();
        const ease = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

        const step = (now) => {
          if (cancelled) { root.style.scrollBehavior = prev; return; }
          const p = Math.min((now - t0) / DUR, 1);
          window.scrollTo(0, start + dist * ease(p));
          if (p < 1) requestAnimationFrame(step);
          else { root.style.scrollBehavior = prev; teardown(); }
        };
        requestAnimationFrame(step);
      }

      arm();
    })();
  </script>
</Base>

<style>
  /* ---------------- HERO ---------------- */
  .hero {
    position: relative;
    padding-top: clamp(3.5rem, 9vw, 7rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
    overflow: hidden;
  }
  .hero-glow {
    position: absolute;
    top: -30%;
    left: 50%;
    transform: translateX(-50%);
    width: min(900px, 110vw);
    aspect-ratio: 1.6 / 1;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--accent) 12%, transparent) 0%,
      transparent 62%
    );
    filter: blur(20px);
    pointer-events: none;
    z-index: 0;
  }

  /* dynamic particle banner (the original del2.gif), anchored right */
  .hero-bg { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .hero-bg video {
    position: absolute; top: 0; right: 0;
    height: 108%; width: 82%;
    object-fit: cover; object-position: center right;
    opacity: 0.9;
    animation: hero-bg-in 1.6s var(--ease) both;
  }
  /* scrim: opaque ink on the left for text legibility, fade right + bottom into the page */
  .hero-bg::after {
    content: ""; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, var(--ink) 14%, color-mix(in srgb, var(--ink) 55%, transparent) 44%, transparent 78%),
      linear-gradient(0deg, var(--ink) 1%, transparent 46%),
      radial-gradient(120% 90% at 50% -10%, transparent 55%, var(--ink) 100%);
  }
  @keyframes hero-bg-in {
    from { opacity: 0; transform: scale(1.06); }
    to { opacity: 0.9; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg video { animation: none; }
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: end;
  }
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
    font-size: 0.78rem;
  }
  .hero-eyebrow .name { color: var(--fg); letter-spacing: 0.14em; }
  .hero-eyebrow .sep { color: var(--accent); }
  .hero-eyebrow .role { color: var(--fg-faint); letter-spacing: 0.18em; }

  .hero-title {
    font-size: clamp(2.6rem, 1.4rem + 5.6vw, 5.6rem);
    margin: 1.25rem 0 0.6rem;
    font-weight: 360;
  }
  .hero-title span { display: block; }
  .hero-title em {
    font-style: italic;
    font-weight: 340;
    color: var(--accent);
  }
  .hero-attr {
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    color: var(--fg-faint);
    margin-bottom: 1.6rem;
  }
  .hero-lede {
    max-width: 46ch;
    font-size: clamp(1.05rem, 0.98rem + 0.5vw, 1.3rem);
    color: var(--fg-dim);
    line-height: 1.6;
  }
  .hero-lede em { color: var(--fg); font-style: italic; }

  .hero-cta { display: flex; gap: 0.9rem; margin-top: 2rem; flex-wrap: wrap; }
  .btn {
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    padding: 0.78rem 1.4rem;
    border-radius: 2px;
    border: 1px solid var(--line);
    transition: all 0.3s var(--ease);
    white-space: nowrap;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
    font-weight: 600;
  }
  .btn-primary:hover { background: transparent; color: var(--accent); }
  .btn-ghost { color: var(--fg-dim); }
  .btn-ghost:hover { color: var(--fg); border-color: var(--fg-dim); }

  .hero-meta {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: color-mix(in srgb, var(--ink-2) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    min-width: 248px;
  }
  .meta-row {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.7rem 1rem;
    font-size: 0.74rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .meta-row:last-child { border-bottom: 0; }
  .meta-row .k { color: var(--fg-faint); letter-spacing: 0.16em; }
  .meta-row .v { color: var(--fg); display: inline-flex; align-items: center; gap: 0.5rem; }
  .live {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .hero-badges {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--line-soft);
    background: color-mix(in srgb, var(--accent) 4%, transparent);
    transition: background 0.35s var(--ease);
  }
  .hero-badges:hover { background: color-mix(in srgb, var(--accent) 9%, transparent); }
  .hero-badges img {
    width: 34px; height: 34px; object-fit: contain;
    filter: drop-shadow(0 0 10px rgba(0, 0, 0, 0.5));
  }
  .hero-badges-note {
    margin-left: auto; text-align: right;
    font-size: 0.6rem; line-height: 1.35; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--fg-faint);
  }

  .hero-strip {
    margin-top: clamp(3rem, 7vw, 5rem);
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line-soft);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--fg-faint);
  }
  .hero-strip span { transition: color 0.3s var(--ease); }
  .hero-strip span:hover { color: var(--accent); }

  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; align-items: start; }
    .hero-meta { width: 100%; }
    /* full-width text over the video needs a stronger, more uniform veil */
    .hero-bg video { width: 100%; opacity: 0.5; }
    .hero-bg::after {
      background:
        linear-gradient(180deg,
          color-mix(in srgb, var(--ink) 30%, transparent) 0%,
          color-mix(in srgb, var(--ink) 72%, transparent) 50%,
          var(--ink) 96%),
        linear-gradient(90deg, var(--ink) 4%, transparent 65%);
    }
  }

  /* ---------------- CREDENTIALS ----------------
     Each badge is mounted in a gauge: a tick bezel that turns slowly, a conic
     sweep that reads as scanning, and a ring that closes on entry. The lime
     stays the only UI signal; the glow behind each seal is tinted to that
     issuer's own brand so the terracotta shield and the pale Google disc sit
     together without either looking pasted on. */
  .creds {
    border-top: 0;
    padding-block: clamp(5rem, 13vw, 11rem);
    overflow: hidden;
  }

  /* oversized ghost word, bled off the section's right edge */
  .creds-ghost {
    position: absolute;
    top: clamp(0.5rem, 3vw, 2.5rem);
    right: -0.06em;
    font-size: clamp(6rem, 21vw, 19rem);
    line-height: 0.8;
    font-weight: 300;
    letter-spacing: -0.045em;
    color: var(--fg);
    opacity: 0.03;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    white-space: nowrap;
  }

  .creds-wallet { color: var(--fg-dim); }

  .cert-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    position: relative;
    z-index: 1;
  }

  .cert { position: relative; }
  .cert-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.6rem, 3.5vw, 2.4rem);
    text-align: center;
    height: 100%;
  }
  .cert-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 14px;
    border-radius: 10px;
  }

  /* ---- the instrument ---- */
  .seal {
    position: relative;
    width: clamp(210px, 27vw, 330px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
  }

  .seal-glow {
    position: absolute;
    inset: -14%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(var(--glow), 0.30) 0%, rgba(var(--glow), 0.07) 42%, transparent 68%);
    filter: blur(26px);
    opacity: 0;
    transform: scale(0.7);
    transition: opacity 1.3s var(--ease) var(--d, 0ms), transform 1.3s var(--ease) var(--d, 0ms);
  }
  .is-in .seal-glow { opacity: 1; transform: scale(1); animation: seal-breathe 6.5s ease-in-out 1.6s infinite; }

  /* conic sweep, masked to a ring — the "scanning" read */
  .seal-sweep {
    position: absolute;
    inset: 3%;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      transparent 276deg,
      color-mix(in srgb, var(--accent) 34%, transparent) 342deg,
      color-mix(in srgb, var(--accent) 72%, transparent) 358deg,
      transparent 360deg
    );
    -webkit-mask: radial-gradient(circle, transparent 0 62%, #000 65%, #000 96%, transparent 98%);
    mask: radial-gradient(circle, transparent 0 62%, #000 65%, #000 96%, transparent 98%);
    opacity: 0;
    transition: opacity 1s var(--ease) calc(var(--d, 0ms) + 700ms);
  }
  .is-in .seal-sweep { opacity: 0.85; animation: seal-spin 7s linear 1.2s infinite; }

  .seal-gauge {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
  }
  /* tick bezel — dashes around the circumference, turning slowly */
  .gauge-ticks {
    stroke: color-mix(in srgb, var(--accent) 26%, transparent);
    stroke-width: 1.4;
    stroke-dasharray: 1.4 7.2;
    stroke-linecap: round;
    transform-origin: 50% 50%;
    opacity: 0;
    transition: opacity 1.2s var(--ease) calc(var(--d, 0ms) + 450ms);
  }
  .is-in .gauge-ticks { opacity: 1; animation: seal-spin 54s linear infinite; }

  .gauge-hair {
    stroke: var(--line);
    stroke-width: 1;
    opacity: 0;
    transition: opacity 1.2s var(--ease) calc(var(--d, 0ms) + 300ms);
  }
  .is-in .gauge-hair { opacity: 1; }

  /* the ring that closes on entry: r=95 → circumference ≈ 596.9 */
  .gauge-draw {
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 596.9;
    stroke-dashoffset: 596.9;
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
    opacity: 0.55;
    transition: stroke-dashoffset 1.9s var(--ease) calc(var(--d, 0ms) + 220ms);
  }
  .is-in .gauge-draw { stroke-dashoffset: 0; }

  .seal-badge {
    position: relative;
    z-index: 1;
    width: 62%;
    height: auto;
    opacity: 0;
    transform: scale(0.82);
    transition: opacity 1.1s var(--ease) var(--d, 0ms), transform 1.2s var(--ease) var(--d, 0ms);
    filter: drop-shadow(0 18px 34px rgba(0, 0, 0, 0.55));
  }
  .is-in .seal-badge { opacity: 1; transform: none; animation: seal-float 7s ease-in-out 1.5s infinite; }
  /* the Google disc carries its own padding; the Anthropic shield bleeds to its
     edges, so they need different insets to read the same size */
  .cert:first-child .seal-badge { width: 57%; }

  .cert:hover .seal-badge { animation-play-state: paused; transform: scale(1.045); }
  .cert:hover .seal-sweep { animation-duration: 2.6s; opacity: 1; }
  .cert:hover .gauge-draw { opacity: 1; stroke-width: 2.1; }

  @keyframes seal-spin    { to { transform: rotate(360deg); } }
  @keyframes seal-float   { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-9px); } }
  @keyframes seal-breathe { 0%, 100% { opacity: 0.8; } 50% { opacity: 1; } }

  /* ---- the readout ---- */
  .cert-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    max-width: 42ch;
    flex: 1;          /* so .cert-verify's margin-top:auto reaches the bottom */
    width: 100%;
  }
  .verified {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
    padding: 0.24rem 0.6rem 0.24rem 0.5rem;
    border-radius: 2px;
  }
  .verified-dot {
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--accent);
    animation: pulse-sm 2.6s var(--ease) infinite;
  }
  @keyframes pulse-sm {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent); }
    70%  { box-shadow: 0 0 0 5px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .cert-issuer {
    font-size: 0.7rem; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--fg-faint); margin-top: 0.25rem;
  }
  /* the headline of the section */
  .cert-name {
    font-size: clamp(1.7rem, 1.05rem + 2.4vw, 2.9rem);
    font-weight: 380;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--fg);
    transition: color 0.4s var(--ease);
    text-wrap: balance;
    min-height: 3.06em; /* three lines: the longest name, so both readouts align */
    display: flex;
    align-items: center;
  }
  .cert:hover .cert-name { color: var(--accent); }

  .cert-blurb {
    color: var(--fg-dim); font-size: 0.95rem; line-height: 1.6;
    margin-top: 0.2rem;
  }

  .cert-spec {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 0 1.8rem; margin-top: 0.9rem;
    padding-top: 1rem; border-top: 1px solid var(--line-soft);
    width: 100%;
  }
  .cert-spec > div { display: flex; flex-direction: column; gap: 0.22rem; padding: 0.35rem 0; }
  .cert-spec dt {
    color: var(--fg-faint); font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase;
  }
  .cert-spec dd { color: var(--fg); font-size: 0.86rem; }

  .cert-skills {
    list-style: none; display: flex; flex-wrap: wrap; justify-content: center;
    gap: 0.4rem; margin-top: 0.9rem;
  }
  .cert-skills li {
    font-size: 0.64rem; letter-spacing: 0.06em; color: var(--fg-dim);
    border: 1px solid var(--line); border-radius: 2px; padding: 0.26rem 0.55rem;
    transition: border-color 0.35s var(--ease);
  }
  .cert:hover .cert-skills li { border-color: color-mix(in srgb, var(--accent) 22%, var(--line)); }
  .cert-skills .more { color: var(--fg-faint); border-style: dashed; }

  .cert-verify {
    margin-top: auto; padding-top: 1.3rem;
    font-size: 0.78rem; color: var(--accent);
    display: inline-flex; align-items: center; gap: 0.35rem;
  }
  .cert-verify span {
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    padding-bottom: 2px;
    transition: border-color 0.35s var(--ease);
  }
  .cert:hover .cert-verify span { border-bottom-color: var(--accent); }

  .cert-past {
    display: flex; align-items: baseline; gap: 1rem 1.4rem; flex-wrap: wrap;
    justify-content: center;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 1.4rem; border-top: 1px solid var(--line-soft);
    font-size: 0.78rem; position: relative; z-index: 1;
  }
  .past-item { color: var(--fg-dim); }
  .past-meta { color: var(--fg-faint); }

  @media (max-width: 900px) {
    .cert-grid { grid-template-columns: 1fr; gap: clamp(3.5rem, 12vw, 5rem); }
    .seal { width: clamp(220px, 58vw, 300px); }
    .cert-name { min-height: 0; }
    .cert-verify { margin-top: 0; }
  }

  /* motion is decoration here — the gauge still reads as a gauge without it */
  @media (prefers-reduced-motion: reduce) {
    .seal-glow, .seal-sweep, .gauge-ticks, .gauge-hair, .seal-badge {
      opacity: 1; transform: none; animation: none; transition: none;
    }
    .seal-sweep { opacity: 0.5; }
    .gauge-draw { stroke-dashoffset: 0; transition: none; }
    .verified-dot { animation: none; }
  }
  /* ---------------- PROJECT CARD ---------------- */
  .proj {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .proj-media {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
    background: var(--ink-2);
  }
  .proj-media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: grayscale(0.2) contrast(1.02);
    transition: transform 0.7s var(--ease), filter 0.7s var(--ease);
  }
  .proj:hover .proj-media img { transform: scale(1.03); filter: grayscale(0); }
  .proj-no {
    position: absolute;
    top: 0.7rem; left: 0.8rem;
    font-size: 0.7rem;
    color: var(--accent);
    background: color-mix(in srgb, var(--ink) 70%, transparent);
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    backdrop-filter: blur(4px);
  }
  .proj-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .proj-tags span {
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    color: var(--fg-dim);
    border: 1px solid var(--line);
    padding: 0.25rem 0.55rem;
    border-radius: 2px;
  }
  .proj-title {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.3rem);
    font-weight: 400;
    line-height: 1.05;
    margin-bottom: 0.9rem;
  }
  .proj-desc { color: var(--fg-dim); max-width: 50ch; margin-bottom: 1.5rem; }
  .spec { border-top: 1px solid var(--line-soft); margin-bottom: 1.4rem; }
  .spec > div {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: 0.8rem;
  }
  .spec dt { color: var(--fg-faint); letter-spacing: 0.12em; font-size: 0.68rem; padding-top: 2px; }
  .spec dd { color: var(--fg-dim); }
  .spec dd b { color: var(--accent); font-weight: 600; }

  .proj-stack { display: flex; flex-direction: column; gap: clamp(3.5rem, 9vw, 7rem); }
  .proj:nth-child(even) .proj-media { order: 2; }

  @media (max-width: 760px) {
    .proj { grid-template-columns: 1fr; }
    .proj:nth-child(even) .proj-media { order: 0; }
  }

  /* ---------------- ABOUT ---------------- */
  .about-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .about-text > * + * { margin-top: 1.4rem; }
  .about-lead {
    font-size: clamp(1.4rem, 1.1rem + 1.4vw, 2.1rem);
    font-weight: 380; line-height: 1.25; color: var(--fg);
    letter-spacing: -0.02em;
  }
  .about-text p { color: var(--fg-dim); max-width: 56ch; }
  .about-text strong { color: var(--fg); font-weight: 600; }
  .about-watch { display: inline-block; margin-top: 0.6rem; font-size: 0.82rem; color: var(--accent); }

  .about-side .label { margin-bottom: 1rem; }
  .about-tags { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
  .about-tags li {
    color: var(--fg-dim); font-size: 0.92rem; padding-left: 1.1rem; position: relative;
  }
  .about-tags li::before {
    content: ""; position: absolute; left: 0; top: 0.55em;
    width: 6px; height: 6px; border-radius: 50%; background: var(--accent);
  }

  @media (max-width: 760px) { .about-grid { grid-template-columns: 1fr; } }

  /* ---- GitHub contribution graph (full-width feature) ---- */
  .gh-feature {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    border: 1px solid var(--line); border-radius: 6px;
    background: var(--ink-2);
    padding: clamp(1.2rem, 3vw, 2rem);
  }
  .gh-feature-head {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 1rem; flex-wrap: wrap; margin-bottom: 1.4rem;
  }
  .gh-feature-head .label { margin: 0; }
  .gh-note { font-size: 0.74rem; color: var(--fg-dim); }
  .gh-chart { width: 100%; overflow-x: auto; }
  .gh-chart :global(svg) { width: 100%; height: auto; min-width: 700px; display: block; }
  .gh-fallback { color: var(--fg-dim); font-size: 0.8rem; padding: 1.5rem 0; }
  .gh-legend {
    display: flex; align-items: center; gap: 0.45rem;
    justify-content: flex-end; margin-top: 1.2rem;
    font-size: 0.7rem; color: var(--fg-faint); letter-spacing: 0.08em;
  }
  .gh-legend .lv { width: 12px; height: 12px; border-radius: 2px; border: 1px solid var(--line-soft); }
  .gh-legend .lv0 { background: var(--ink-3); }
  .gh-legend .lv1 { background: color-mix(in srgb, var(--accent) 28%, var(--ink-3)); }
  .gh-legend .lv2 { background: color-mix(in srgb, var(--accent) 52%, var(--ink-3)); }
  .gh-legend .lv3 { background: color-mix(in srgb, var(--accent) 76%, var(--ink-3)); }
  .gh-legend .lv4 { background: var(--accent); }

  /* ---------------- SKILLS ---------------- */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .skill-head {
    font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--accent); padding-bottom: 0.8rem; margin-bottom: 0.8rem;
    border-bottom: 1px solid var(--line);
  }
  .skill-list { list-style: none; display: flex; flex-direction: column; gap: 0.55rem; }
  .skill-list li { color: var(--fg-dim); font-size: 0.92rem; }
  @media (max-width: 720px) { .skills-grid { grid-template-columns: 1fr 1fr; gap: 2rem; } }
