  </section>

  <!-- ============ 05 — TESTIMONIALS ============ -->
  <section class="section" id="feedback">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="label idx">05</span>
        <h2>What clients say</h2>
        <span class="rule"></span>
        <span class="label">Verbatim &middot; Upwork</span>
