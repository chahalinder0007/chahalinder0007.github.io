---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const projects = [
  {
    n: "01",
    title: "Custom Loss Function for Text Detection",
    tags: ["Computer Vision", "OCR", "Research"],
    img: "/images/Portfolio/portfolio/Loss_function.png",
    desc: "A custom objective using Fourier-transform loss that makes reliable predictions even for single-character maps — pushing detection quality past the standard baseline on a public benchmark.",
    spec: [
      ["METRIC", "F1 93.19 → 95.51 on ICDAR-13", true],
      ["STACK", "TensorFlow · NumPy · custom loss"],
      ["ROLE", "Research & implementation"],
    ],
  },
  {
    n: "02",
    title: "Autonomous Echocardiogram Analysis",
    tags: ["Computer Vision", "Medical AI", "End-to-End DL"],
    img: "/images/Portfolio/portfolio/sample_1.gif",
    desc: "A robotic, intelligent radiologist — a fully automated device that tests and quantifies the functions of a radiologist using state-of-the-art AI and mathematical tools, delivering near-human and, under some conditions, better-than-human results.",
    spec: [
      ["SCOPE", "Autonomous, end-to-end deep learning"],
      ["DOMAIN", "Cardiac imaging diagnostics"],
      ["OUTPUT", "Quantified cardiac function"],
    ],
  },
  {
    n: "03",
    title: "ATM Surveillance & Suspicious-Object Detection",
    tags: ["Computer Vision", "Real-Time", "Monitoring"],
    img: "/images/Portfolio/portfolio/atm_surv.png",
    desc: "An end-to-end package to monitor and secure ATMs. A custom-trained AI watches every machine without human assistance — reading people count, posture, suspicious objects and aggressive expressions — and raises alerts on customizable conditions, while all streams feed a central GUI for single-point monitoring.",
    spec: [
      ["STACK", "TensorFlow · Keras · OpenCV"],
      ["OPS", "Prometheus · Grafana · WebSockets"],
      ["ROLE", "Architecture & implementation"],
    ],
  },
  {
    n: "04",
    title: "Seq2Seq Chatbot with Attention",
    tags: ["NLP", "Deep Learning", "Seq2Seq"],
    img: "/images/Portfolio/portfolio/chatbot.png",
    desc: "An encoder–decoder architecture with trainable embeddings and Bahdanau + Luong attention — capturing intent and long-range dependencies by focusing on the right words and retaining far more context than a vanilla encoder–decoder.",
    spec: [
      ["STACK", "TensorFlow · seq2seq"],
      ["METHOD", "Bahdanau + Luong attention"],
      ["ROLE", "Model design & training"],
    ],
  },
];

const certifications = [
  {
    id: "7cc3e382-b86c-45f1-a864-0bb3e1513f5b",
    name: "Claude Certified Architect",
    tier: "Professional",
    issuer: "Anthropic",
    img: "/images/badges/claude-architect-professional.png",
    thumb: "/images/badges/claude-architect-professional-64.png",
    issued: "Sep 2026",
    validTo: "Sep 2027",
    level: "Professional",
    glow: "217, 119, 87",
    blurb:
      "Designing and leading enterprise-scale Claude deployments — integration architecture, optimisation at scale, and responsible-deployment governance.",
    skills: [
      "Enterprise Architecture",
      "Context engineering",
      "Solution Design",
      "AI Governance",
    ],
    more: 4,
  },
  {
    id: "f7ce50c0-2c19-4564-9027-d9f941c0a955",
    name: "Professional Machine Learning Engineer",
    tier: "Google Cloud",
    issuer: "Google Cloud",
    img: "/images/badges/gcp-professional-ml-engineer.png",
    thumb: "/images/badges/gcp-professional-ml-engineer-64.png",
    issued: "Sep 2026",
    validTo: "Sep 2028",
    level: "Advanced",
    glow: "138, 170, 229",
    blurb:
      "Building, evaluating, productionising and optimising ML models on Google Cloud — large datasets, repeatable pipelines, responsible AI throughout.",
    skills: [
      "Vertex AI",
      "ML Ops",
      "Machine Learning",
      "BigQuery ML",
    ],
    more: 7,
  },
];

// Lapsed, kept for the record rather than claimed in the present tense.
const pastCertifications = [
  {
    id: "b65b584a-ae95-436b-a529-bf5b3d1ea0c5",
    name: "Associate Cloud Engineer",
    issuer: "Google Cloud",
    window: "2022 \u2192 2024",
  },
];

const skills = [
  {
    head: "Deep Learning",
    items: ["TensorFlow", "Keras", "OpenCV", "Seq2Seq", "Attention (Bahdanau / Luong)", "Custom loss design"],
  },
  {
    head: "Domains",
    items: ["Computer Vision", "OCR", "NLP", "Recommender Systems", "Medical Imaging"],
  },
  {
    head: "Cloud & Ops",
    items: ["Google Cloud (GCP)", "Prometheus", "Grafana", "WebSockets", "Cloud Architecture"],
  },
  {
    head: "Foundations",
    items: ["Linear Algebra", "Probability & Bayesian methods", "Stochastic Processes", "Fourier Analysis"],
  },
];

const latestPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat("en", { year: "numeric", month: "short" });

// Transcribed verbatim from the Upwork review cards in
// public/images/Portfolio/Feedbacks/. A trailing "\u2026" means Upwork itself
// truncated the review in the original capture — nothing has been paraphrased.
const feedbacks = [
  { quote: "Inderjit is great. I have used him on previous projects and I will no doubt be using him again in the near future.", by: "Upwork client" },
  { quote: "Went above and beyond. I recommend Inderjit without any reservation whatsoever for any ML project that you need done.", by: "Upwork client" },
  { quote: "Inderjit was fantastic. I don\u2019t want to end this contract but he has a conflict that I have to respect. I will definitely hire him again as soon\u2026", by: "Upwork client" },
  { quote: "Inderjit is a very passionate ML expert who is great at what he does. He is willing to fully understand the client\u2019s requirements before\u2026", by: "Upwork client" },
  { quote: "It\u2019s a second project that I do with Inderjit. As in the first one, I had the pleasure working with a professional, independent and communicative\u2026", by: "Upwork client" },
  { quote: "My work with Inder has been a very positive experience.", by: "Upwork client" },
  { quote: "Inderjit is very responsive and brilliant in communication. His work is also of great quality and high standard. I look forward to working with\u2026", by: "Upwork client" },
  { quote: "Excellent work from Inderjit. His willingness to help is exceptional and his quality of work and response times are great. I look forward to\u2026", by: "Upwork client" },
  { quote: "Inderjit is excellent to work with, does high quality work, gets work done on time and work very well with clients to offer solutions and explain\u2026", by: "Upwork client" },
  { quote: "Inder is a very smart entrepreneurial freelancer with a can-do attitude. He has gone above and beyond during our collaboration on an\u2026", by: "Upwork client" },
  { quote: "Timely, thorough, skilled and insightful. No critiques.", by: "Python code manual reviewer" },
  { quote: "Inderjit did an excellent job at understanding our requirements and executing on them via both the written end product, code base and video demonstrating the\u2026", by: "Upwork client" },
];

// GitHub contribution graph: fetch the default-green SVG (it has a clean 5-step
// palette) and recolor it to the dark-theme lime gradient so every contribution
// level reads clearly. Snapshotted at build time — no runtime dependency.
let ghSvg = "";
try {
  const res = await fetch("https://ghchart.rshah.org/chahalinder0007");
  if (res.ok) {
    ghSvg = await res.text();
    const recolor = {
      "#eeeeee": "#171a20", // empty days  → dark grid cell
      "#c6e48b": "#48562d", // level 1     → dim lime
      "#7bc96f": "#728a38", // level 2
      "#239a3b": "#9cbe43", // level 3
      "#196127": "#c6f24e", // level 4     → full accent lime
      "#767676": "#6a6c70", // month / day labels → muted
    };
    for (const [from, to] of Object.entries(recolor)) {
      ghSvg = ghSvg.replaceAll(from, to);
    }
    // make the root <svg> responsive (only the first width/height = root)
    ghSvg = ghSvg.replace(
      /width="(\d+)" height="(\d+)"/,
      'viewBox="0 0 $1 $2" preserveAspectRatio="xMinYMin meet"'
    );
  }
} catch {
  ghSvg = "";
}
---

<Base>
  <Nav />

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <video autoplay loop muted playsinline preload="auto">
        <source src="/images/del2.webm" type="video/webm" />
        <source src="/images/del2.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-main">
        <p class="label hero-eyebrow" data-reveal style="--d:0ms">
          <span class="name">Inderjit Singh Chahal</span>
          <span class="sep" aria-hidden="true">/</span>
          <span class="role">Machine Learning Engineer</span>
        </p>
        <h1 class="display hero-title">
          <span data-reveal style="--d:80ms">Mathematics,</span>
          <span data-reveal style="--d:180ms">the <em>music of reason.</em></span>
        </h1>
        <p class="hero-attr mono" data-reveal style="--d:260ms">
          — J.&thinsp;J. Sylvester, 1864
        </p>
        <p class="hero-lede" data-reveal style="--d:340ms">
          I take that conviction to work — turning rigorous math
          into <em>production deep-learning systems</em>: autonomous medical imaging,
          custom OCR objectives, attention-based NLP. Models that ship.
        </p>
        <div class="hero-cta" data-reveal style="--d:440ms">
          <a href="#work" class="btn btn-primary">View selected work</a>
          <a href="#contact" class="btn btn-ghost">Get in touch</a>
        </div>
      </div>

      <aside class="hero-meta mono" data-reveal style="--d:480ms">
        <a class="hero-badges" href="#credentials" aria-label="Jump to verified credentials">
          {certifications.map((c) => (
            <img src={c.thumb} alt={`${c.name} badge`} width="34" height="34" loading="eager" />
          ))}
          <span class="hero-badges-note">2 active<br />certifications</span>
        </a>
        <div class="meta-row">
          <span class="k">STATUS</span>
          <span class="v"><span class="live"></span>Open to ML roles</span>
        </div>
        <div class="meta-row">
          <span class="k">CERT</span>
          <span class="v">Claude Cert. Architect</span>
        </div>
        <div class="meta-row">
          <span class="k">CERT</span>
          <span class="v">Google Pro ML Engineer</span>
        </div>
        <div class="meta-row">
          <span class="k">FOCUS</span>
          <span class="v">CV · NLP · Cloud</span>
        </div>
        <div class="meta-row">
          <span class="k">CONTACT</span>
          <span class="v">inder@inderjit.in</span>
        </div>
      </aside>
    </div>

    <div class="wrap hero-strip mono" data-reveal style="--d:600ms" aria-hidden="true">
      <span>PYTHON</span><span>TENSORFLOW</span><span>KERAS</span><span>OPENCV</span>
      <span>GCP</span><span>PROMETHEUS</span><span>GRAFANA</span><span>WEBSOCKETS</span>
    </div>
  </section>


  <!-- ============ 01 — CREDENTIALS ============ -->
  <!-- Each credential is mounted as an instrument: a seal in a gauge with a
       tick bezel, a sweep that reads as scanning, and a ring that closes on
       entry. All of it decorative — the link and its label carry the meaning. -->
  <section class="section creds" id="credentials">
    <span class="creds-ghost display" aria-hidden="true">Certified</span>

    <div class="wrap">
      <div class="section-head" data-reveal>
        <span class="label idx">01</span>
        <h2>Certified</h2>
        <span class="rule"></span>
        <a
          class="label link creds-wallet"
          href="https://www.credly.com/users/inderjit-singh-chahal/badges"
          target="_blank"
          rel="noopener noreferrer">Credly wallet &#8599;</a>
      </div>

      <div class="cert-grid">
        {certifications.map((c, i) => (
          <article class="cert" data-reveal style={`--d:${i * 160}ms; --glow:${c.glow}`}>
            <a
              class="cert-link"
              href={`https://www.credly.com/badges/${c.id}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Verify ${c.name}, issued by ${c.issuer}, on Credly`}>

              <span class="seal">
                <span class="seal-glow" aria-hidden="true"></span>
                <span class="seal-sweep" aria-hidden="true"></span>
                <svg class="seal-gauge" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
                  <circle class="gauge-ticks" cx="100" cy="100" r="95" />
                  <circle class="gauge-hair" cx="100" cy="100" r="86" />
                  <circle class="gauge-draw" cx="100" cy="100" r="95" />
